# Copy this file to ".env" (in this same folder) and put your key after the = sign.
# The real .env file is never uploaded to GitHub.
GEMINI_API_KEY=

# The fast model is tried first. If it is busy, the backup model answers.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BACKUP_MODEL=gemini-3.8-flash

# More models to try, in order, when the first two are busy or out of quota.
GEMINI_EXTRA_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash
